{
  "entities": {
    "Document": {
      "title": "Document",
      "description": "A collaborative document.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the document." },
        "content": { "type": "string", "description": "The markdown content of the document." },
        "authorId": { "type": "string", "description": "The UID of the author." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["title", "content", "authorId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "A collection of documents."
    }
  }
}
